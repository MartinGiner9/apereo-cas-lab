# Apereo CAS
CAS_VERSION=8.0.1.2
CAS_SERVER_NAME=https://localhost:8443
CAS_SERVER_PREFIX=https://localhost:8443/cas

# PostgreSQL
POSTGRES_DB=cas
POSTGRES_USER=cas
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# CAS JDBC authentication
CAS_DB_URL=jdbc:postgresql://postgres:5432/cas
CAS_DB_USER=cas
CAS_DB_PASSWORD=change-me-local-only
